# Auto detect text files and perform LF normalization
* text=auto

# Anything executed by a shell or read inside a container must keep LF
# in the WORKING TREE too, not just in the repo. `text=auto` alone
# checks these out with CRLF on Windows, and bash then fails on the
# carriage return — which is a clean clone that cannot run its own
# scripts.
*.sh      text eol=lf
*.conf    text eol=lf
*.yml     text eol=lf
.env.*    text eol=lf

# The built web bundle round-trips as OPAQUE BYTES. `text=auto` above would
# otherwise autodetect the .js/.json/.html in it as text and rewrite their line
# endings, so the file nginx serves is not the file that was built and tested —
# flutter_service_worker.js alone lost 31 bytes that way. Nothing in a build
# artefact should be edited by hand, so there is nothing for normalisation to
# fix, and a bundle whose content hashes stop matching its bytes fails silently.
public/nginx/html/** -text
