# ─────────────────────────────────────────────
# SaamSaam — .env template (secrets filled by build-env.py)
#
# Env-specific config lives in .env.live / .env.staging.
# Those files override anything here for their respective
# API containers via docker compose `env_file`.
# ─────────────────────────────────────────────

# ── Project ──────────────────────────────────
# The shared network this stack joins. Owned by teo-infra / gentick-infra when
# one is running; svc-start.sh creates it if nothing else has.
SHARED_NET=backend-net

COMPOSE_PROJECT_NAME=saamsaam
CONTAINER_PREFIX=saamsaam
STAGING_CONTAINER_PREFIX=saamsaam-staging

# ── Image tags (bumped per deploy) ───────────
API_IMAGE_TAG=0.2.2
STAGING_API_IMAGE_TAG=0.2.3

# ── Port bindings ────────────────────────────
WEB_HTTP_PORT=8080
WEB_HTTPS_PORT=443

# ── Data ─────────────────────────────────────
HOST_DATA_ROOT=./data
CERTS_DIR=./certs
TZ=Africa/Johannesburg

# ── GHCR credentials ─────────────────────────
GHCR_USER=your-github-username
GHCR_PAT=your-classic-pat-here

# ── API defaults (shared; overridden per env) ─
API_PORT=8080
API_ACCESS_TTL_MIN=60
API_REFRESH_TTL_DAYS=30
API_JWT_SECRET=at-least-32-bytes-long-random-string
PUBLIC_BASE_URL=https://localhost
LOG_LEVEL=info
REMINDER_SWEEP_INTERVAL=30s

# ── Postgres (shared instance) ───────────────
# PG_HOST is the name on backend-net, so it resolves to whichever postgres is
# running — teo-infra's when this host has shared infra, ours when it does not.
# Never change it to a container name; that breaks the --private/--public swap.
PG_HOST=postgres
PG_PORT=5432
# Host-side loopback publish, so `psql -h 127.0.0.1 -p <port>` works over SSH
# and tests can reach it from outside Docker. A variable because live and
# staging share a machine.
PG_HOST_PORT=5432
PG_USER=saamsaam
PG_PASSWORD=strong-random-password
PG_DB=saamsaam

# ── Redis (shared instance) ──────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379

# ── SMTP ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=teojordaan@gmail.com
SMTP_PASSWORD=your-smtp-password-here
SMTP_FROM=teojordaan@gmail.com
SMTP_FROM_NAME=SaamSaam
SMTP_TLS_MODE=starttls

# ── Telegram ─────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=your_bot_name
TELEGRAM_MODE=poll
TELEGRAM_WEBHOOK_SECRET=
