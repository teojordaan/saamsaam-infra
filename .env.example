# Example .env for SaamSaam's infrastructure. Copy to .env and fill in the
# values, or run ./svc-build-env.sh to fill the secrets from the creds directory.
#
# Three things that will bite silently if you don't know them:
#
#   1. Compose interpolates this file, so a literal $ must be doubled.
#      pa$word reaches the container as "pa". pa$$word reaches it as "pa$word".
#      Compose warns and continues; it never fails. svc-build-env.sh handles this.
#   2. `env_file:` and `--env-file` are different mechanisms. env_file: does not
#      feed ${...}. Every compose call needs --env-file explicitly.
#   3. Do not set COMPOSE_PROJECT_NAME. It outranks the `name:` field in both
#      compose files and would merge the private and public stacks into one.

#───────────────────── Server PC Environment ─────────────────────
PROJECT_NAME=saamsaam
HOST_DATA_ROOT=/srv/data
PROJECT_DATA_ROOT=${HOST_DATA_ROOT}/${PROJECT_NAME}
SHARED_NETWORK=backend-net
TZ=Africa/Johannesburg

#───────────────────── Nginx ─────────────────────
NGINX_HOST=nginx

#───────────────────── Postgres ─────────────────────
POSTGRES_HOST=postgres
POSTGRES_HOST_PORT=5432
POSTGRES_PORT=5432
POSTGRES_DB=${PROJECT_NAME}
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me

#───────────────────── Redis ─────────────────────
REDIS_HOST=redis
REDIS_HOST_PORT=6379
REDIS_PORT=6379

#───────────────────── API ─────────────────────
# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_FROM_NAME=SaamSaam
SMTP_USER=replace@me.com
SMTP_PASSWORD=replace-me
SMTP_FROM=replace@me.com
# Telegram
TELEGRAM_MODE=poll
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_BOT_USERNAME=replace-me
TELEGRAM_WEBHOOK_SECRET=replace-me
# Misc
API_PORT=8080
API_ACCESS_TTL_MIN=60
API_REFRESH_TTL_DAYS=30
API_JWT_SECRET_SAAMSAAM=replace-me-with-a-32-byte-minimum-secret
# PUBLIC_BASE_URL is set per-environment in .env.live and .env.staging, both of
# which override it — a value here would be dead. It prefixes the links the API
# emails (verify / invite / reset) and the Telegram webhook URL it registers.
LOG_LEVEL=info
REMINDER_SWEEP_INTERVAL=30s
