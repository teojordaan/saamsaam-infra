# Example .env for SaamSaam's infrastructure. Copy to .env and fill in the
# values, or run ./svc-build-env.sh to fill the secrets from the creds directory.
#
# Three things that will bite silently if you don't know them:
#
#   1. Compose interpolates this file, so a literal $ must be doubled.
#      pa$word reaches the container as "pa". pa$$word reaches it as "pa$word".
#      Compose warns and continues; it never fails. svc-build-env.sh handles this.
#   2. `env_file:` and `--env-file` are different mechanisms. env_file: does not
#      feed ${...}. Every compose call needs --env-file explicitly.
#   3. Do not set COMPOSE_PROJECT_NAME. It outranks the `name:` field in both
#      compose files and would merge the private and public stacks into one.

#───────────────────── Server PC Environment ─────────────────────
PROJECT_NAME=saamsaam
# HOST_DATA_ROOT is a server path (/srv/data). For local/WSL dev it MUST point
# INSIDE the WSL filesystem (e.g. /var/lib/..., never /mnt/c/...). A bind mount
# onto a Windows drive lands on DrvFs, which does not implement chmod, so
# postgres initdb fails with "could not change permissions of directory" and the
# container crash-loops. The compose file looks correct; the real error is three
# levels down in `docker logs`.
HOST_DATA_ROOT=/srv/data
PROJECT_DATA_ROOT=${HOST_DATA_ROOT}/${PROJECT_NAME}
SHARED_NETWORK=backend-net
TZ=Africa/Johannesburg

#───────────────────── Nginx ─────────────────────
NGINX_HOST=nginx

#───────────────────── Postgres ─────────────────────
POSTGRES_HOST=postgres
POSTGRES_HOST_PORT=5432
POSTGRES_PORT=5432
POSTGRES_DB=${PROJECT_NAME}
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me

#───────────────────── Redis ─────────────────────
REDIS_HOST=redis
REDIS_HOST_PORT=6379
REDIS_PORT=6379
# REDIS_PASSWORD authenticates against a password-protected redis. The shared
# providers (local-infra, gentick-infra) start redis with --requirepass, so the
# API must send this or every command comes back NOAUTH and the login cooldown
# silently disables itself. The key name matches those repos' pragma exactly so
# one shared secret feeds all of them (infra-repos.md: reuse existing names).
# The API treats it as optional — an empty value sends no AUTH, which is correct
# against a passwordless redis — but here it is a secret filled from the pragma.
REDIS_PASSWORD=replace-me

#───────────────────── API ─────────────────────
# API_IMAGE_TAG selects the saamsaam-api image tag compose runs
# (compose.yml: ${API_IMAGE_TAG:-0.0.0-staging}). This tracked .env.example is
# its committed home and the source of truth for the deployed version — an image
# tag MUST live in a tracked file so the running version is visible in git
# history (infra-repos.md). Keep it here; do NOT move it into the gitignored .env,
# where it would hide the deployed version from history. A harness overrides it
# per-run via the PROCESS environment (compose reads the shell env before .env),
# which touches no tracked file — that is how flutter.sh points the stack at a
# :testing image.
API_IMAGE_TAG=0.0.0-staging
# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_FROM_NAME=SaamSaam
SMTP_USER=replace@me.com
SMTP_PASSWORD=replace-me
SMTP_FROM=replace@me.com
# Telegram
# TELEGRAM_BOT_TOKEN is per-box: each box polls its OWN bot with its OWN token
# from its pragma, because getUpdates is single-consumer per token — two boxes
# sharing one token 409-fight each other (and the real bot). So the dev box and
# the live box MUST hold different tokens. A box that should not run Telegram at
# all leaves its pragma token empty (the api reads an empty token as "disabled":
# it leaves the bot nil, logs "telegram disabled", and starts no poller). That
# per-box empty value replaces the old committed .env.staging empty-token hack.
TELEGRAM_MODE=poll
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_BOT_USERNAME=replace-me
TELEGRAM_WEBHOOK_SECRET=replace-me
# Misc
API_PORT=8080
API_ACCESS_TTL_MIN=60
API_REFRESH_TTL_DAYS=30
API_JWT_SECRET_SAAMSAAM=replace-me-with-a-32-byte-minimum-secret
# SIGNUP_RATE_LIMIT_PER_HOUR caps POST /v1/auth/signup per client IP per hour.
# 5 is the API's built-in production default, so leaving it here changes nothing;
# the value is spelled out for visibility. The contract-test harness overrides it
# far higher for the isolated :testing stack, where many self-provisioning tests
# share one client IP. Raise it for a deployment that legitimately creates many
# accounts quickly.
SIGNUP_RATE_LIMIT_PER_HOUR=5
# LOGIN_RATE_LIMIT_PER_15MIN caps POST /v1/auth/login per client IP per 15
# minutes (BE-M13's anti-brute-force limit — each attempt costs a bcrypt verify).
# 10 is the API's built-in production default, so leaving it here changes nothing;
# spelled out for visibility beside the signup cap. The contract-test harness
# overrides it far higher for the isolated :testing stack, where every
# self-provisioning test logs in from the one shared client IP.
LOGIN_RATE_LIMIT_PER_15MIN=10
# PUBLIC_BASE_URL prefixes the links the API emails (verify / invite / reset) and
# the Telegram webhook URL it registers, so it MUST be THIS box's own public
# domain — the dev box's sm.teojordaan.com, the live box's saamsaam.archyta.com.
# Getting it wrong is silent and damaging: the API emails real users links to the
# wrong site, and it cannot be derived from a request (the Telegram webhook and
# the reminder sweeper build links with no request in scope, and trusting the Host
# header would let an attacker poison reset links). It is not a secret, but it IS
# per-box, so it is marked `replace` to force each box to declare its own via the
# pragma: svc-build-env refuses to write .env until it is filled, turning a
# forgettable deploy step into a hard gate. See infra-repos.md — `replace` marks a
# value the host must supply, of which a per-machine setting like this is one kind.
# This is the single declaration; there is no per-environment .env.live/.env.staging
# override any more (one instance per box), so the pragma value reaches the api.
PUBLIC_BASE_URL=replace-me
LOG_LEVEL=info
REMINDER_SWEEP_INTERVAL=30s
